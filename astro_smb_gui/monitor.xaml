<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RowSpacing="8" Padding="4">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <!-- 统计条 -->
  <Border Grid.Row="0" CornerRadius="6" Padding="12,10"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
    <Grid ColumnSpacing="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock x:Name="StatSpeed" Text="0 B/s" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="总速度" FontSize="11" Opacity="0.6"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock x:Name="StatRunning" Text="0" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="进行中" FontSize="11" Opacity="0.6"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock x:Name="StatQueued" Text="0" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="排队中" FontSize="11" Opacity="0.6"/>
      </StackPanel>
      <StackPanel Grid.Column="3">
        <TextBlock x:Name="StatDone" Text="0" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="已完成" FontSize="11" Opacity="0.6"/>
      </StackPanel>
      <StackPanel Grid.Column="5" VerticalAlignment="Center">
        <TextBlock Text="分块并发" FontSize="11" Opacity="0.6"/>
        <ComboBox x:Name="ChunkWorkersBox" MinWidth="70" SelectedIndex="2">
          <ComboBoxItem Content="1"/>
          <ComboBoxItem Content="2"/>
          <ComboBoxItem Content="4"/>
          <ComboBoxItem Content="6"/>
          <ComboBoxItem Content="8"/>
        </ComboBox>
      </StackPanel>
      <Button x:Name="CancelAllBtn" Grid.Column="6" Content="全部取消" VerticalAlignment="Center"/>
      <Button x:Name="ClearDoneBtn" Grid.Column="7" Content="清除已完成" VerticalAlignment="Center"/>
    </Grid>
  </Border>

  <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="暂无传输任务 — 到「浏览」页下载或上传文件后,这里会实时显示进度与分块状态"
             Opacity="0.6" Margin="4,0"/>

  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="4" Padding="0,0,8,8">
      <TextBlock x:Name="RunningHeader" Text="进行中" FontWeight="SemiBold" Margin="4,4,0,2"
                 Visibility="Collapsed"/>
      <StackPanel x:Name="RunningPanel" Spacing="6"/>
      <TextBlock x:Name="QueuedHeader" Text="排队中" FontWeight="SemiBold" Margin="4,8,0,2"
                 Visibility="Collapsed"/>
      <StackPanel x:Name="QueuedPanel" Spacing="4"/>
      <TextBlock x:Name="DoneHeader" Text="已完成 / 已结束" FontWeight="SemiBold" Margin="4,8,0,2"
                 Visibility="Collapsed"/>
      <StackPanel x:Name="DonePanel" Spacing="4"/>
    </StackPanel>
  </ScrollViewer>
</Grid>
