<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RowSpacing="8" Padding="4">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- 工具栏: 刷新 / 夜次 / 时刻滑杆 / 地平线开关 / 实际视场开关 / 回正视角 -->
  <Grid Grid.Row="0" ColumnSpacing="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Button x:Name="RefreshBtn" Grid.Column="0" Content="刷新"/>
    <ProgressRing x:Name="RefreshRing" Grid.Column="1" Width="20" Height="20" IsActive="False"/>
    <TextBlock Grid.Column="2" Text="夜次" VerticalAlignment="Center" Opacity="0.8"/>
    <ComboBox x:Name="NightCombo" Grid.Column="3" MinWidth="210" PlaceholderText="(无数据)"/>
    <TextBlock Grid.Column="4" Text="时刻" VerticalAlignment="Center" Opacity="0.8"
               Margin="6,0,0,0"/>
    <Slider x:Name="TimeSlider" Grid.Column="5" Minimum="0" Maximum="1000"
            MinWidth="140" VerticalAlignment="Center" IsThumbToolTipEnabled="False"/>
    <StackPanel Grid.Column="6" Spacing="0" MinWidth="142" VerticalAlignment="Center">
      <TextBlock x:Name="TimeText" Text="—" FontFamily="Consolas" FontSize="12"/>
      <TextBlock x:Name="TimeRangeText" Text="整夜范围" FontSize="10" Opacity="0.6"
                 TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <TextBlock Grid.Column="7" Text="地平线" VerticalAlignment="Center" Opacity="0.8"
               FontSize="12"/>
    <ToggleSwitch x:Name="HorizonToggle" Grid.Column="8" OnContent="" OffContent=""
                  MinWidth="0" IsOn="True" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="9" Text="实际视场" VerticalAlignment="Center" Opacity="0.8"
               FontSize="12"/>
    <ToggleSwitch x:Name="FootprintToggle" Grid.Column="10" OnContent="" OffContent=""
                  MinWidth="0" IsOn="False" VerticalAlignment="Center"/>
    <Button x:Name="ResetBtn" Grid.Column="11" Content="回正视角" FontSize="12"/>
  </Grid>

  <!-- 主体: 左 = WebView2 3D 天球(带加载/降级遮罩) | 右 = 详情卡片 -->
  <Grid Grid.Row="1" ColumnSpacing="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="330"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" CornerRadius="6" BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="#0B0E16">
      <!-- WebView2 由代码 InsertAt(0) 插到最底层, 遮罩始终盖在它上面 -->
      <Grid x:Name="ViewHost">
        <StackPanel x:Name="OverlayPanel" Spacing="10" MaxWidth="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <ProgressRing x:Name="LoadRing" IsActive="True" Width="30" Height="30"
                        HorizontalAlignment="Center"/>
          <TextBlock x:Name="LoadText" Text="正在准备 3D 天球 …" FontSize="13"
                     Foreground="#DCE5F2" TextWrapping="Wrap"
                     TextAlignment="Center" HorizontalAlignment="Center"/>
          <ProgressBar x:Name="LoadBar" Width="260" Visibility="Collapsed"
                       HorizontalAlignment="Center"/>
          <Button x:Name="RetryBtn" Content="重试" Visibility="Collapsed"
                  HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 右栏详情卡片: 徽章 / 参数 pill / 目标分区 / 键值分区 / 站点 -->
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled">
      <StackPanel Spacing="8" Padding="0,0,6,0">
        <StackPanel x:Name="BadgeRow" Orientation="Horizontal" Spacing="6"
                    Visibility="Collapsed"/>
        <TextBlock x:Name="CardTitle" Text="3D 天球" FontSize="17" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="CardSub" Text="连接设备后读取拍摄日志" FontSize="12"
                   Opacity="0.75" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        <StackPanel x:Name="PillRow" Orientation="Horizontal" Spacing="6"
                    Visibility="Collapsed"/>

        <!-- 目标分区: 每行 色点 + 名字 + 高度徽章 + 迷你高度条(代码搭建) -->
        <StackPanel x:Name="TargetPanel" Spacing="0"/>

        <!-- 选中/悬停目标的两列键值(代码搭建) -->
        <Grid x:Name="DetailGrid" ColumnSpacing="10" RowSpacing="3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
        </Grid>

        <!-- 实际视场(足迹)进度/状态: 解算是重活, 必须看得见在跑什么 -->
        <StackPanel x:Name="FootPanel" Spacing="4" Visibility="Collapsed">
          <TextBlock x:Name="FootStatus" Text="" FontSize="12" Opacity="0.8"
                     TextWrapping="Wrap"/>
          <ProgressBar x:Name="FootBar" Visibility="Collapsed" Height="3"/>
          <Button x:Name="FootCancelBtn" Content="停止解算" FontSize="12"
                  Visibility="Collapsed" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- 星表缺失时的优雅降级入口(足迹需要板解算, 板解算需要星表) -->
        <StackPanel x:Name="CatalogPanel" Spacing="4" Visibility="Collapsed">
          <TextBlock x:Name="CatalogText" FontSize="12" TextWrapping="Wrap"
                     Opacity="0.85" IsTextSelectionEnabled="True"
                     Text="需要星表才能显示实际视场"/>
          <ProgressBar x:Name="CatalogBar" Visibility="Collapsed" Height="3"/>
          <Button x:Name="CatalogBtn" Content="下载星表" FontSize="12"
                  HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- 覆盖卡(该目标的 N 张 sub 合起来盖住了什么) -->
        <StackPanel x:Name="CoverPanel" Spacing="0"/>

        <!-- 选中的单张 sub 详情 -->
        <StackPanel x:Name="SubPanel" Spacing="0"/>

        <!-- 站点: 纬度可改(日志推不出), 经度由 PHD2 时角反推 -->
        <StackPanel x:Name="SitePanel" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="纬度" VerticalAlignment="Center" FontSize="12"/>
            <TextBox x:Name="LatBox" Width="68" FontSize="12"/>
            <TextBlock Text="经度" VerticalAlignment="Center" FontSize="12" Margin="6,0,0,0"/>
            <TextBlock x:Name="LonText" Text="—" VerticalAlignment="Center" FontSize="12"
                       Opacity="0.8"/>
            <Button x:Name="SiteApplyBtn" Content="应用" FontSize="12" Margin="4,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <!-- 底部: 状态 + 署名(ESO CC BY 4.0 / three.js MIT) -->
  <Grid Grid.Row="2" ColumnSpacing="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock x:Name="StatusText" Grid.Column="0" Text="" FontSize="12" Opacity="0.75"
               TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"/>
    <TextBlock x:Name="CreditText" Grid.Column="1" Text="" FontSize="10" Opacity="0.6"
               TextTrimming="CharacterEllipsis"/>
  </Grid>
</Grid>
