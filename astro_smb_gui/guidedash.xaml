<!-- 导星仪表盘**面板**(由 _guidedash.GuideDashboard 载入并挂进导星页右侧的 DashHost)。
     它不是遮罩:左侧段列表始终可见可点,点任意段即切回段视图,所以这里
     没有背景色 / 没有负边距 / 没有关闭按钮 + Esc 那一套模态包袱。
     图表画布尺寸**全部在代码里按面板实际宽度算**(_guidedash.chart_layout),
     xaml 只给容器 —— 窄窗口下自动减列,永远不出现横向滚动条。
     全部文本只用 BMP 字符(win32more 转 HSTRING 按码点数给长度, 星平面字符会吞尾字)。 -->
<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="DashPanel" RowSpacing="6">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <!-- 标题行:字号/层级与段视图标题行一致 -->
  <Grid Grid.Row="0" ColumnSpacing="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
      <TextBlock x:Name="DashTitle" FontSize="15" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis" Text="导星仪表盘"/>
      <TextBlock x:Name="DashSubTitle" FontSize="11" Opacity="0.65"
                 TextTrimming="CharacterEllipsis" Text=""/>
    </StackPanel>
    <ProgressRing x:Name="DashRing" Grid.Column="1" Width="20" Height="20"
                  IsActive="False" VerticalAlignment="Center"/>
    <Button x:Name="DashCopyBtn" Grid.Column="2" Content="复制全部信息"
            FontSize="11" Padding="8,2,8,3" VerticalAlignment="Center"/>
    <Button x:Name="DashBackBtn" Grid.Column="3" Content="◀ 段视图"
            FontSize="11" Padding="8,2,8,3" VerticalAlignment="Center"
            ToolTipService.ToolTip="回到选中导星段的曲线视图(点左侧任意段也一样)"/>
  </Grid>

  <!-- 正文:只纵向滚动。横向必须 Disabled —— 一是用户明确不要横滚条,
       二是只有横向受约束时正文才拿得到有限宽度,图表才能按宽度重排。 -->
  <ScrollViewer x:Name="DashScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled" HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled" Padding="0,0,8,0">
    <StackPanel x:Name="DashBody" Spacing="10">

      <!-- 汇总卡:徽章 / 目标 / 副标题 / 参数胶囊 / 分区 KV(排版语言同浏览页详情卡) -->
      <Border CornerRadius="6" Padding="12,10,12,10"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <StackPanel Spacing="6">
          <StackPanel x:Name="DashBadges" Orientation="Horizontal" Spacing="6"
                      Visibility="Collapsed"/>
          <TextBlock x:Name="DashTargetText" FontSize="16" FontWeight="SemiBold"
                     TextWrapping="Wrap" IsTextSelectionEnabled="True" Text=""/>
          <TextBlock x:Name="DashSubText" FontSize="12" Opacity="0.7"
                     TextWrapping="Wrap" Text=""/>
          <StackPanel x:Name="DashPills" Orientation="Horizontal" Spacing="6"
                      Visibility="Collapsed"/>
          <Grid x:Name="DashKv" ColumnSpacing="12" RowSpacing="3" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock x:Name="DashNotes" FontSize="11" Opacity="0.7"
                 TextWrapping="Wrap" Visibility="Collapsed" Text=""/>

      <!-- 图表区。8 张等尺寸小图放进 VariableSizedWrapGrid:面板变宽就多排一列,
           变窄就换行,**布局层自己重排, 不需要重画** —— 画布尺寸只在 _render
           (或宽度真的变了以后的防抖重画)时算一次。 -->
      <StackPanel x:Name="DashCharts" Spacing="10">
        <VariableSizedWrapGrid x:Name="DashWrap" Orientation="Horizontal"
                               ItemWidth="272" ItemHeight="196">
          <StackPanel Spacing="2">
            <TextBlock Text="偏差散点(含 1x/2x RMS 圆与椭圆)"
                       FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
            <Border CornerRadius="4" BorderThickness="1" HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
              <Canvas x:Name="DashScatterCanvas" Background="Transparent"/>
            </Border>
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Text="偏差直方图(叠加正态拟合)"
                       FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
            <Border CornerRadius="4" BorderThickness="1" HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
              <Canvas x:Name="DashHistCanvas" Background="Transparent"/>
            </Border>
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Text="滚动 RMS(30 帧窗 · 竖线为段边界)"
                       FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
            <Border CornerRadius="4" BorderThickness="1" HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
              <Canvas x:Name="DashRollCanvas" Background="Transparent"/>
            </Border>
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Text="修正脉冲方向配比"
                       FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
            <Border CornerRadius="4" BorderThickness="1" HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
              <Canvas x:Name="DashPulseCanvas" Background="Transparent"/>
            </Border>
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Text="修正脉冲时长直方图"
                       FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
            <Border CornerRadius="4" BorderThickness="1" HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
              <Canvas x:Name="DashPulseHistCanvas" Background="Transparent"/>
            </Border>
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Text="SNR / 星质量(红刻度 = 丢星帧)"
                       FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
            <Border CornerRadius="4" BorderThickness="1" HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
              <Canvas x:Name="DashSnrCanvas" Background="Transparent"/>
            </Border>
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Text="RA 误差自相关(周期误差指纹)"
                       FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
            <Border CornerRadius="4" BorderThickness="1" HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
              <Canvas x:Name="DashAcfCanvas" Background="Transparent"/>
            </Border>
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Text="RA 周期图(rFFT 幅值谱)"
                       FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
            <Border CornerRadius="4" BorderThickness="1" HorizontalAlignment="Left"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
              <Canvas x:Name="DashPeriodCanvas" Background="Transparent"/>
            </Border>
          </StackPanel>
        </VariableSizedWrapGrid>

        <!-- 通栏图:宽度 = 面板正文宽,画的时候现算(见 _wide_width) -->
        <StackPanel Spacing="2">
          <TextBlock Text="分段对比(条长 = 时长 · 颜色 = 该段 RMS · 点击定位到主曲线)"
                     FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
          <Border CornerRadius="4" BorderThickness="1" HorizontalAlignment="Left"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Canvas x:Name="DashSegCanvas" Height="120" Background="Transparent"/>
          </Border>
        </StackPanel>

        <StackPanel x:Name="DashSubCard" Spacing="2" Visibility="Collapsed">
          <TextBlock Text="每张 sub 曝光期间的导星 RMS(红柱 = 废片候选)"
                     FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
          <Border CornerRadius="4" BorderThickness="1" HorizontalAlignment="Left"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Canvas x:Name="DashSubCanvas" Height="180" Background="Transparent"/>
          </Border>
        </StackPanel>
      </StackPanel>

      <TextBlock x:Name="DashEmpty" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                 Visibility="Collapsed" Text=""/>
    </StackPanel>
  </ScrollViewer>
</Grid>
