<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ColumnSpacing="10">
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="215"/>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="330"/>
  </Grid.ColumnDefinitions>

  <!-- 左:共享列表 + 容量 -->
  <Grid Grid.Column="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="共享" FontWeight="SemiBold" Margin="4,2,0,6"/>
    <ListView x:Name="SharesList" Grid.Row="1" SelectionMode="Single"/>
    <Border Grid.Row="2" Margin="2,8,2,2" Padding="8" CornerRadius="4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <StackPanel Spacing="4">
        <TextBlock x:Name="VolTitle" Text="容量" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
        <ProgressBar x:Name="VolBar" Minimum="0" Maximum="100" Value="0"/>
        <TextBlock x:Name="VolText" Text="选择共享查看容量" FontSize="11" Opacity="0.7"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </Grid>

  <!-- 中:文件浏览 -->
  <Grid Grid.Column="1" RowSpacing="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" ColumnSpacing="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="UpBtn" Grid.Column="0" Content="上级" IsEnabled="False"/>
      <Button x:Name="RefreshBtn" Grid.Column="1" Content="刷新" IsEnabled="False"/>
      <TextBlock x:Name="PathText" Grid.Column="2" Text="(未打开共享)"
                 VerticalAlignment="Center" Opacity="0.85"
                 TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"/>
    </Grid>

    <Grid Grid.Row="1" ColumnSpacing="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="DownloadBtn" Grid.Column="0" Content="下载选中"/>
      <Button x:Name="UploadFilesBtn" Grid.Column="1" Content="上传文件…"/>
      <Button x:Name="UploadDirBtn" Grid.Column="2" Content="上传文件夹…"/>
      <Button x:Name="NewDirBtn" Grid.Column="3" Content="新建目录"/>
      <Button x:Name="AnalyzeBtn" Grid.Column="4" Content="分析占用"/>
      <TextBox x:Name="SearchBox" Grid.Column="5" PlaceholderText="递归搜索当前目录,如 *.fit(回车)"/>
      <Button x:Name="SearchBtn" Grid.Column="6" Content="搜索"/>
    </Grid>

    <Grid Grid.Row="2" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="排序" VerticalAlignment="Center" Opacity="0.7"/>
      <ComboBox x:Name="SortBox" Grid.Column="1" MinWidth="120" SelectedIndex="0">
        <ComboBoxItem Content="名称 ↑"/>
        <ComboBoxItem Content="名称 ↓"/>
        <ComboBoxItem Content="大小 ↑"/>
        <ComboBoxItem Content="大小 ↓"/>
        <ComboBoxItem Content="时间 ↑"/>
        <ComboBoxItem Content="时间 ↓"/>
        <ComboBoxItem Content="扩展名/类型"/>
      </ComboBox>
      <TextBlock Grid.Column="3" Text="勾选模式" VerticalAlignment="Center" Opacity="0.7"/>
      <ToggleSwitch x:Name="CheckboxToggle" Grid.Column="4" OnContent="" OffContent="" MinWidth="0"/>
    </Grid>

    <ListView x:Name="FileList" Grid.Row="3" SelectionMode="Extended"
              AllowDrop="True" CanDragItems="True">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="10,2,10,2"/>
          <Setter Property="MinHeight" Value="34"/>
        </Style>
      </ListView.ItemContainerStyle>
    </ListView>

    <TextBlock x:Name="ListStatusText" Grid.Row="4" Text="" Opacity="0.7" FontSize="12"/>
  </Grid>

  <!-- 右:详情与预览 -->
  <Grid Grid.Column="2">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="详情" FontWeight="SemiBold" Margin="4,2,0,6"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8" Padding="4,0,12,12">
        <TextBlock x:Name="PreviewTitle" Text="(未选中)" FontWeight="SemiBold"
                   TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        <Grid MinHeight="40">
          <Image x:Name="PreviewImage" MaxHeight="300" Stretch="Uniform"
                 HorizontalAlignment="Left"/>
          <ProgressRing x:Name="PreviewRing" Width="28" Height="28"
                        IsActive="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </Grid>
        <TextBlock x:Name="ThumbSourceText" Text="" FontSize="11" Opacity="0.6"/>
        <Button x:Name="LoadFullBtn" Content="下载原图并生成拉伸预览" Visibility="Collapsed"/>

        <!-- 天文卡片:徽章/目标/参数胶囊/分区键值 + 迷你天球雷达 -->
        <Border x:Name="AstroCard" CornerRadius="6" Padding="12,10,12,10" Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <StackPanel Spacing="6">
            <StackPanel x:Name="AstroBadges" Orientation="Horizontal" Spacing="6"
                        Visibility="Collapsed"/>
            <TextBlock x:Name="AstroTargetText" Text="" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            <TextBlock x:Name="AstroSubText" Text="" FontSize="12" Opacity="0.7"
                       TextWrapping="Wrap"/>
            <!-- 参数胶囊:曝光/增益/温度 -->
            <StackPanel x:Name="AstroPills" Orientation="Horizontal" Spacing="6"
                        Visibility="Collapsed"/>
            <Grid x:Name="AstroGrid" ColumnSpacing="12" RowSpacing="3" Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
            </Grid>
            <Canvas x:Name="DetailRadar" Width="190" Height="190" Margin="0,4,0,0"
                    HorizontalAlignment="Left" Visibility="Collapsed"/>
          </StackPanel>
        </Border>

        <!-- 文件卡片:大小/时间/属性/位置 -->
        <Border x:Name="FileCard" CornerRadius="6" Padding="12,10,12,10" Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <Grid x:Name="FileGrid" ColumnSpacing="12" RowSpacing="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
          </Grid>
        </Border>

        <Button x:Name="CopyDetailBtn" Content="复制全部信息" FontSize="11"
                Padding="8,2,8,3" HorizontalAlignment="Left" Visibility="Collapsed"/>

        <TextBlock x:Name="PreviewTextBlock" Text="" FontSize="11" FontFamily="Consolas"
                   TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed"/>
        <ToggleButton x:Name="FitsToggle" Content="完整 FITS 头" Visibility="Collapsed"/>
        <TextBlock x:Name="FitsText" Text="" FontSize="11" FontFamily="Consolas"
                   TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Grid>
