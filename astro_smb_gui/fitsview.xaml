<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RowSpacing="6">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- 工具条:文件名 + 缩放 + 跳转 -->
  <Grid Grid.Row="0" ColumnSpacing="6">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock x:Name="TitleText" Grid.Column="0" Text="(未打开文件)"
               VerticalAlignment="Center" FontWeight="SemiBold"
               TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"/>
    <Button x:Name="FitBtn" Grid.Column="1" Content="适应窗口"/>
    <Button x:Name="OneToOneBtn" Grid.Column="2" Content="1:1"/>
    <Button x:Name="ZoomOutBtn" Grid.Column="3" Content="−" MinWidth="38"/>
    <Button x:Name="ZoomInBtn" Grid.Column="4" Content="+" MinWidth="38"/>
    <TextBlock x:Name="ZoomText" Grid.Column="5" Text="—" MinWidth="58"
               VerticalAlignment="Center" Opacity="0.75"/>
    <Button x:Name="RevealBtn" Grid.Column="6" Content="在浏览页中显示" IsEnabled="False"/>
    <Button x:Name="ReloadBtn" Grid.Column="7" Content="重新加载" IsEnabled="False"/>
    <Button x:Name="SolveBtn" Grid.Column="8" Content="解算" IsEnabled="False"/>
  </Grid>

  <!-- 信息条:目标 / 徽章 / 参数胶囊(沿用浏览页详情卡的设计语言) -->
  <Border x:Name="InfoCard" Grid.Row="1" CornerRadius="6" Padding="12,8,12,9"
          Visibility="Collapsed"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
    <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
        <TextBlock x:Name="InfoTitle" Text="" FontSize="16" FontWeight="SemiBold"
                   IsTextSelectionEnabled="True"/>
        <TextBlock x:Name="InfoSub" Text="" FontSize="12" Opacity="0.7"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
        <StackPanel x:Name="InfoBadges" Orientation="Horizontal" Spacing="6"
                    Visibility="Collapsed"/>
        <StackPanel x:Name="InfoPills" Orientation="Horizontal" Spacing="6"
                    Visibility="Collapsed"/>
      </StackPanel>
    </Grid>
  </Border>

  <!-- 主体:左图像 + 右控制面板 -->
  <Grid Grid.Row="2" ColumnSpacing="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="330"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" CornerRadius="6" BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <Grid>
        <!-- Min/MaxZoomFactor 是 Single:XamlReader 运行时解析赋不进去
             (真机报 Failed to assign to property),只能在代码里设 -->
        <ScrollViewer x:Name="ImageScroll" ZoomMode="Enabled"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled">
          <!-- 双缓冲:新帧在背面 Image 解码完成(ImageOpened)后才翻面,
               拖拉伸滑杆时正面始终显示旧帧,不会闪白 -->
          <Grid x:Name="ImageHost" Background="Transparent"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="ImageA" Stretch="Fill"/>
            <Image x:Name="ImageB" Stretch="Fill" Opacity="0"/>
            <!-- 星点/匹配标记:与图同尺寸,批量 XamlReader 片段铺进来 -->
            <Canvas x:Name="StarLayer" IsHitTestVisible="False"/>
          </Grid>
        </ScrollViewer>
        <StackPanel x:Name="BusyPanel" Spacing="8" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <ProgressRing x:Name="BusyRing" Width="42" Height="42" IsActive="False"
                        HorizontalAlignment="Center"/>
          <TextBlock x:Name="BusyText" Text="" FontSize="12" Opacity="0.8"
                     HorizontalAlignment="Center"/>
          <ProgressBar x:Name="BusyBar" Width="220" Minimum="0" Maximum="100" Value="0"/>
          <Button x:Name="CancelBtn" Content="取消" HorizontalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="EmptyText" Text="从浏览页双击一个 .fit / .fits 文件打开"
                   Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <ScrollViewer x:Name="SidePanel" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8" Padding="0,0,12,12">

        <!-- 拉伸控制 -->
        <Border CornerRadius="6" Padding="12,10,12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <StackPanel Spacing="6">
            <TextBlock Text="拉伸" FontSize="13" FontWeight="SemiBold"/>
            <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch" SelectedIndex="0">
              <ComboBoxItem Content="STF 自动拉伸(PixInsight 口径)"/>
              <ComboBoxItem Content="asinh 拉伸"/>
              <ComboBoxItem Content="百分位线性拉伸"/>
            </ComboBox>
            <Grid x:Name="LinkedRow" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="通道链接(关=自动白平衡)"
                         FontSize="12" Opacity="0.75" VerticalAlignment="Center"
                         TextWrapping="Wrap"/>
              <ToggleSwitch x:Name="LinkedToggle" Grid.Column="1" OnContent=""
                            OffContent="" MinWidth="0"/>
            </Grid>

            <StackPanel x:Name="StfPanel" Spacing="0">
              <TextBlock x:Name="ShadowLabel" Text="阴影裁切 −2.80 σ"
                         FontSize="12" Opacity="0.75"/>
              <Slider x:Name="ShadowSlider" Minimum="-6" Maximum="0"
                      StepFrequency="0.05" Value="-2.8"/>
              <TextBlock x:Name="TargetLabel" Text="目标背景 0.250"
                         FontSize="12" Opacity="0.75"/>
              <Slider x:Name="TargetSlider" Minimum="0.02" Maximum="0.6"
                      StepFrequency="0.005" Value="0.25"/>
            </StackPanel>

            <StackPanel x:Name="AsinhPanel" Spacing="0" Visibility="Collapsed">
              <TextBlock x:Name="AsinhLabel" Text="asinh 强度 a = 100"
                         FontSize="12" Opacity="0.75"/>
              <Slider x:Name="AsinhSlider" Minimum="0" Maximum="4"
                      StepFrequency="0.05" Value="2"/>
            </StackPanel>

            <StackPanel x:Name="PctPanel" Spacing="0" Visibility="Collapsed">
              <TextBlock x:Name="LoLabel" Text="下限 0.20%" FontSize="12" Opacity="0.75"/>
              <Slider x:Name="LoSlider" Minimum="0" Maximum="5"
                      StepFrequency="0.01" Value="0.2"/>
              <TextBlock x:Name="HiLabel" Text="上限 99.80%" FontSize="12" Opacity="0.75"/>
              <Slider x:Name="HiSlider" Minimum="90" Maximum="100"
                      StepFrequency="0.01" Value="99.8"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button x:Name="ResetBtn" Content="恢复默认" FontSize="11"
                      Padding="8,2,8,3"/>
              <Button x:Name="SaveBtn" Content="另存为 PNG…" FontSize="11"
                      Padding="8,2,8,3" IsEnabled="False"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 直方图 -->
        <Border CornerRadius="6" Padding="12,10,12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <StackPanel Spacing="6">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="直方图" FontSize="13"
                         FontWeight="SemiBold" VerticalAlignment="Center"/>
              <ToggleButton x:Name="HistToggle" Grid.Column="1" Content="拉伸前"
                            FontSize="11" Padding="8,2,8,3"/>
            </Grid>
            <Border CornerRadius="4" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
              <Canvas x:Name="HistCanvas" Width="292" Height="130"
                      Background="Transparent"/>
            </Border>
            <TextBlock x:Name="HistHint" Text="" FontSize="11" Opacity="0.6"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- 拍摄参数(分区 KV,与浏览页详情卡同一套排版) -->
        <Border x:Name="AstroCard" CornerRadius="6" Padding="12,10,12,10"
                Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <Grid x:Name="AstroGrid" ColumnSpacing="12" RowSpacing="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
          </Grid>
        </Border>

        <!-- 影像结构(位深/相位/数据区) -->
        <Border x:Name="ImageCard" CornerRadius="6" Padding="12,10,12,10"
                Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <Grid x:Name="ImageGrid" ColumnSpacing="12" RowSpacing="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
          </Grid>
        </Border>

        <Border x:Name="SolveCard" CornerRadius="6" Padding="10,8,10,9"
                Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
          <StackPanel Spacing="4">
            <TextBlock x:Name="SolveTitle" Text="板解算" FontWeight="SemiBold"
                       FontSize="12"/>
            <TextBlock x:Name="SolveStatus" Text="" FontSize="11" Opacity="0.8"
                       TextWrapping="Wrap"/>
            <Grid x:Name="SolveGrid" ColumnSpacing="12" RowSpacing="3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ToggleButton x:Name="StarToggle" Content="显示星点" FontSize="11"
                            Padding="8,2,8,3" Visibility="Collapsed"/>
              <Button x:Name="SolveCancelBtn" Content="取消" FontSize="11"
                      Padding="8,2,8,3" Visibility="Collapsed"/>
              <Button x:Name="CatalogDownloadBtn" Content="下载星表" FontSize="11"
                      Padding="8,2,8,3" Visibility="Collapsed"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Button x:Name="CopyBtn" Content="复制全部信息" FontSize="11"
                Padding="8,2,8,3" HorizontalAlignment="Left" Visibility="Collapsed"/>
        <ToggleButton x:Name="HdrToggle" Content="完整 FITS 头" Visibility="Collapsed"/>
        <TextBlock x:Name="HdrText" Text="" FontSize="11" FontFamily="Consolas"
                   TextWrapping="Wrap" IsTextSelectionEnabled="True"
                   Visibility="Collapsed"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>

  <!-- 底部:像素读数 + 状态 -->
  <Grid Grid.Row="3" ColumnSpacing="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <TextBlock x:Name="ReadoutText" Grid.Column="0" Text="" FontSize="12"
               FontFamily="Consolas" IsTextSelectionEnabled="True"/>
    <TextBlock x:Name="StatusText" Grid.Column="1" Text="" FontSize="12"
               Opacity="0.7" TextTrimming="CharacterEllipsis"/>
  </Grid>
</Grid>
